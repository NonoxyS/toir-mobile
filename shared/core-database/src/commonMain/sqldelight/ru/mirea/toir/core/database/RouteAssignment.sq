import ru.mirea.toir.core.database.models.LocalRouteAssignmentStatus;

CREATE TABLE IF NOT EXISTS route_assignments (
    id TEXT NOT NULL PRIMARY KEY,
    route_id TEXT NOT NULL,
    user_id TEXT NOT NULL,
    status TEXT AS LocalRouteAssignmentStatus NOT NULL,
    assigned_at TEXT NOT NULL,
    shift_code TEXT,
    updated_at TEXT NOT NULL
);

upsertRouteAssignment:
INSERT OR REPLACE INTO route_assignments (id, route_id, user_id, status, assigned_at, shift_code, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM route_assignments;

selectById:
SELECT * FROM route_assignments WHERE id = ?;

updateStatus:
UPDATE route_assignments SET status = ? WHERE id = ?;

deleteAll:
DELETE FROM route_assignments;

deleteById:
DELETE FROM route_assignments WHERE id = ?;
