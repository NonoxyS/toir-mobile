import ru.mirea.toir.core.database.storage.inspection.models.LocalEquipmentResultStatus;
import ru.mirea.toir.core.database.models.LocalSyncStatus;
import ru.mirea.toir.core.database.models.LocalRejectionReason;

CREATE TABLE IF NOT EXISTS inspection_equipment_results (
    id TEXT NOT NULL PRIMARY KEY,
    inspection_id TEXT NOT NULL,
    route_point_id TEXT NOT NULL,
    equipment_id TEXT NOT NULL,
    status TEXT AS LocalEquipmentResultStatus NOT NULL,
    started_at TEXT,
    completed_at TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    sync_status TEXT AS LocalSyncStatus NOT NULL,
    sync_attempt_count INTEGER NOT NULL DEFAULT 0,
    sync_next_attempt_at TEXT,
    sync_rejection_reason TEXT AS LocalRejectionReason
);

insertResult:
INSERT INTO inspection_equipment_results (
    id, inspection_id, route_point_id, equipment_id, status, started_at, completed_at, created_at, updated_at, sync_status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByInspectionId:
SELECT * FROM inspection_equipment_results WHERE inspection_id = ?;

selectById:
SELECT * FROM inspection_equipment_results WHERE id = ?;

selectByRoutePointAndInspection:
SELECT * FROM inspection_equipment_results
WHERE route_point_id = ? AND inspection_id = ?
LIMIT 1;

updateStatus:
UPDATE inspection_equipment_results SET status = ?, started_at = ?, completed_at = ?, updated_at = ? WHERE id = ?;

selectPendingReady:
SELECT * FROM inspection_equipment_results
WHERE sync_status = 'pending'
  AND (sync_next_attempt_at IS NULL OR sync_next_attempt_at <= :now);

selectPendingCount:
SELECT count(*) FROM inspection_equipment_results WHERE sync_status = 'pending';

markRetryScheduled:
UPDATE inspection_equipment_results
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt
WHERE id = :id;

markRejected:
UPDATE inspection_equipment_results
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt,
    sync_rejection_reason = :reason
WHERE id = :id;

markSynced:
UPDATE inspection_equipment_results
SET sync_status = 'synced',
    sync_attempt_count = 0,
    sync_next_attempt_at = NULL,
    sync_rejection_reason = NULL
WHERE id = :id;
