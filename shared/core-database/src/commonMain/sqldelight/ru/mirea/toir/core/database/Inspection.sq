import ru.mirea.toir.core.database.models.LocalInspectionStatus;
import ru.mirea.toir.core.database.models.LocalSyncStatus;

CREATE TABLE IF NOT EXISTS inspections (
    id TEXT NOT NULL PRIMARY KEY,
    assignment_id TEXT,
    route_id TEXT NOT NULL,
    status TEXT AS LocalInspectionStatus NOT NULL,
    started_at TEXT,
    completed_at TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    sync_status TEXT AS LocalSyncStatus NOT NULL,
    sync_attempt_count INTEGER NOT NULL DEFAULT 0,
    sync_next_attempt_at TEXT,
    sync_last_error TEXT
);

insertInspection:
INSERT INTO inspections (id, assignment_id, route_id, status, started_at, completed_at, created_at, updated_at, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByAssignmentId:
SELECT * FROM inspections WHERE assignment_id = ?;

selectById:
SELECT * FROM inspections WHERE id = ?;

updateStatus:
UPDATE inspections SET status = ?, completed_at = ?, updated_at = ? WHERE id = ?;

selectPendingReady:
SELECT * FROM inspections
WHERE sync_status = 'pending'
  AND (sync_next_attempt_at IS NULL OR sync_next_attempt_at <= :now);

selectPendingCount:
SELECT count(*) FROM inspections WHERE sync_status = 'pending';

markRetryScheduled:
UPDATE inspections
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt,
    sync_last_error = :reason
WHERE id = :id;

markSynced:
UPDATE inspections
SET sync_status = 'synced',
    sync_attempt_count = 0,
    sync_next_attempt_at = NULL,
    sync_last_error = NULL
WHERE id = :id;
