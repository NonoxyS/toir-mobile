import ru.mirea.toir.core.database.models.LocalSyncStatus;
import ru.mirea.toir.core.database.models.LocalRejectionReason;

CREATE TABLE IF NOT EXISTS checklist_item_results (
    id TEXT NOT NULL PRIMARY KEY,
    inspection_equipment_result_id TEXT NOT NULL,
    checklist_item_id TEXT NOT NULL,
    value_boolean INTEGER,
    value_number REAL,
    value_text TEXT,
    selected_option TEXT,
    comment TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    sync_status TEXT AS LocalSyncStatus NOT NULL,
    sync_attempt_count INTEGER NOT NULL DEFAULT 0,
    sync_next_attempt_at TEXT,
    sync_rejection_reason TEXT AS LocalRejectionReason
);

insertOrReplaceResult:
INSERT OR REPLACE INTO checklist_item_results (
    id, inspection_equipment_result_id, checklist_item_id,
    value_boolean, value_number, value_text, selected_option, comment,
    created_at, updated_at, sync_status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByEquipmentResultId:
SELECT * FROM checklist_item_results WHERE inspection_equipment_result_id = ?;

selectByChecklistItemAndEquipmentResult:
SELECT * FROM checklist_item_results
WHERE checklist_item_id = ? AND inspection_equipment_result_id = ?
LIMIT 1;

selectPendingReady:
SELECT * FROM checklist_item_results
WHERE sync_status = 'pending'
  AND (sync_next_attempt_at IS NULL OR sync_next_attempt_at <= :now);

selectPendingCount:
SELECT count(*) FROM checklist_item_results WHERE sync_status = 'pending';

markRetryScheduled:
UPDATE checklist_item_results
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt
WHERE id = :id;

-- Rejected record stays in sync_status='pending' intentionally.
-- See docs/superpowers/specs/2026-05-12-sync-pending-indicator-redesign.md (Known issues).
markRejected:
UPDATE checklist_item_results
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt,
    sync_rejection_reason = :reason
WHERE id = :id;

markSynced:
UPDATE checklist_item_results
SET sync_status = 'synced',
    sync_attempt_count = 0,
    sync_next_attempt_at = NULL,
    sync_rejection_reason = NULL
WHERE id = :id;
