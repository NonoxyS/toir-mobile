import ru.mirea.toir.core.database.models.LocalSyncStatus;

CREATE TABLE IF NOT EXISTS action_logs (
    id TEXT NOT NULL PRIMARY KEY,
    action_type TEXT NOT NULL,
    entity_type TEXT,
    entity_id TEXT,
    payload_json TEXT,
    action_time TEXT NOT NULL,
    sync_status TEXT AS LocalSyncStatus NOT NULL,
    sync_attempt_count INTEGER NOT NULL DEFAULT 0,
    sync_next_attempt_at TEXT,
    sync_last_error TEXT
);

insertActionLog:
INSERT INTO action_logs (id, action_type, entity_type, entity_id, payload_json, action_time, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM action_logs;

selectPendingReady:
SELECT * FROM action_logs
WHERE sync_status = 'pending'
  AND (sync_next_attempt_at IS NULL OR sync_next_attempt_at <= :now);

selectPendingCount:
SELECT count(*) FROM action_logs WHERE sync_status = 'pending';

markRetryScheduled:
UPDATE action_logs
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt,
    sync_last_error = :reason
WHERE id = :id;

markSynced:
UPDATE action_logs
SET sync_status = 'synced',
    sync_attempt_count = 0,
    sync_next_attempt_at = NULL,
    sync_last_error = NULL
WHERE id = :id;
