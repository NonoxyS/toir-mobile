CREATE TABLE IF NOT EXISTS routes (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT
);

upsertRoute:
INSERT OR REPLACE INTO routes (id, code, name, description)
VALUES (?, ?, ?, ?);

selectAll:
SELECT * FROM routes;

selectById:
SELECT * FROM routes WHERE id = ?;

deleteAll:
DELETE FROM routes;

deleteById:
DELETE FROM routes WHERE id = ?;
