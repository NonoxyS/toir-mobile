CREATE TABLE IF NOT EXISTS checklists (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    equipment_type TEXT NOT NULL,
    description TEXT
);

upsertChecklist:
INSERT OR REPLACE INTO checklists (id, code, name, equipment_type, description)
VALUES (?, ?, ?, ?, ?);

selectAll:
SELECT * FROM checklists;

selectById:
SELECT * FROM checklists WHERE id = ?;

selectByEquipmentType:
SELECT * FROM checklists WHERE equipment_type = ? LIMIT 1;

deleteAll:
DELETE FROM checklists;

deleteById:
DELETE FROM checklists WHERE id = ?;
