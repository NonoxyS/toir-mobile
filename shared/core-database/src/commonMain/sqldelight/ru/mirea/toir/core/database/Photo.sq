import ru.mirea.toir.core.database.models.LocalSyncStatus;

CREATE TABLE IF NOT EXISTS photos (
    id TEXT NOT NULL PRIMARY KEY,
    checklist_item_result_id TEXT NOT NULL,
    file_uri TEXT NOT NULL,
    taken_at TEXT NOT NULL,
    sync_status TEXT AS LocalSyncStatus NOT NULL,
    storage_key TEXT,
    sync_attempt_count INTEGER NOT NULL DEFAULT 0,
    sync_next_attempt_at TEXT,
    sync_last_error TEXT
);

insertPhoto:
INSERT INTO photos (id, checklist_item_result_id, file_uri, taken_at, sync_status, storage_key)
VALUES (?, ?, ?, ?, ?, ?);

selectByChecklistItemResultId:
SELECT * FROM photos WHERE checklist_item_result_id = ?;

selectByEquipmentResultId:
SELECT photos.* FROM photos
JOIN checklist_item_results
    ON photos.checklist_item_result_id = checklist_item_results.id
WHERE checklist_item_results.inspection_equipment_result_id = ?;

selectPendingReady:
SELECT * FROM photos
WHERE sync_status = 'pending'
  AND (sync_next_attempt_at IS NULL OR sync_next_attempt_at <= :now);

selectPendingCount:
SELECT count(*) FROM photos WHERE sync_status = 'pending';

markRetryScheduled:
UPDATE photos
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt,
    sync_last_error = :reason
WHERE id = :id;

markSynced:
UPDATE photos
SET sync_status = 'synced',
    sync_attempt_count = 0,
    sync_next_attempt_at = NULL,
    sync_last_error = NULL,
    storage_key = :storageKey
WHERE id = :id;

deletePhoto:
DELETE FROM photos WHERE id = ?;
