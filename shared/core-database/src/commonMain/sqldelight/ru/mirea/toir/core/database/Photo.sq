import ru.mirea.toir.core.database.models.LocalSyncStatus;

CREATE TABLE IF NOT EXISTS photos (
    id TEXT NOT NULL PRIMARY KEY,
    checklist_item_result_id TEXT NOT NULL,
    file_uri TEXT,
    taken_at TEXT NOT NULL,
    sync_status TEXT AS LocalSyncStatus NOT NULL,
    storage_key TEXT,
    file_name TEXT,
    mime_type TEXT,
    size_bytes INTEGER,
    checksum TEXT,
    sync_attempt_count INTEGER NOT NULL DEFAULT 0,
    sync_next_attempt_at TEXT,
    sync_last_error TEXT
);

insertPhoto:
INSERT INTO photos (id, checklist_item_result_id, file_uri, taken_at, sync_status, storage_key)
VALUES (?, ?, ?, ?, ?, ?);

-- Inserts metadata for a server-restored photo. file_uri stays NULL until the
-- file is downloaded (see selectMissingFiles / setFileUri). On conflict with an
-- existing row, applies the merge rule (§1.3 of Waypoint 11): UPDATE only if
-- the local row is already 'synced'; pending/retry/rejected rows are preserved.
insertRestoredPhoto:
INSERT INTO photos (
    id, checklist_item_result_id, file_uri, taken_at, sync_status,
    storage_key, file_name, mime_type, size_bytes, checksum,
    sync_attempt_count, sync_next_attempt_at, sync_last_error
) VALUES (
    :id, :checklistItemResultId, NULL, :takenAt, 'synced',
    :storageKey, :fileName, :mimeType, :sizeBytes, :checksum,
    0, NULL, NULL
)
ON CONFLICT(id) DO UPDATE SET
    checklist_item_result_id = excluded.checklist_item_result_id,
    taken_at = excluded.taken_at,
    sync_status = 'synced',
    storage_key = excluded.storage_key,
    file_name = excluded.file_name,
    mime_type = excluded.mime_type,
    size_bytes = excluded.size_bytes,
    checksum = excluded.checksum,
    sync_attempt_count = 0,
    sync_next_attempt_at = NULL,
    sync_last_error = NULL
WHERE photos.sync_status = 'synced';

selectByChecklistItemResultId:
SELECT * FROM photos WHERE checklist_item_result_id = ?;

selectByEquipmentResultId:
SELECT photos.* FROM photos
JOIN checklist_item_results
    ON photos.checklist_item_result_id = checklist_item_results.id
WHERE checklist_item_results.inspection_equipment_result_id = ?;

selectPendingReady:
SELECT * FROM photos
WHERE sync_status = 'pending'
  AND (sync_next_attempt_at IS NULL OR sync_next_attempt_at <= :now);

selectPendingCount:
SELECT count(*) FROM photos WHERE sync_status = 'pending';

-- Photos whose metadata is restored but whose file is not yet downloaded.
selectMissingFiles:
SELECT * FROM photos
WHERE file_uri IS NULL AND storage_key IS NOT NULL;

setFileUri:
UPDATE photos SET file_uri = :fileUri WHERE id = :id;

markRetryScheduled:
UPDATE photos
SET sync_attempt_count = :attemptCount,
    sync_next_attempt_at = :nextAt,
    sync_last_error = :reason
WHERE id = :id;

markSynced:
UPDATE photos
SET sync_status = 'synced',
    sync_attempt_count = 0,
    sync_next_attempt_at = NULL,
    sync_last_error = NULL,
    storage_key = :storageKey
WHERE id = :id;

deletePhoto:
DELETE FROM photos WHERE id = ?;
